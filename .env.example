# Exemple pour un serveur Node / Docker local uniquement.
# En production Vercel, créez ces variables dans Settings > Environment Variables.
ADMIN_TOKEN=change-me-with-a-long-random-secret
ADMIN_CODE=ABC123
MEMBER_SHORT_SECRET=change-me-with-an-independent-random-secret-at-least-32-characters
DATA_FILE=./data/store.json
PORT=3000
TRUST_PROXY=0

# Stockage production recommandé : Supabase Postgres
CALASORGA_STORAGE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx
SUPABASE_STATE_TABLE=calasorga_state
SUPABASE_STATE_ID=main

# Sécurité : laissez 0/absent en production normale.
# Mettez temporairement 1 seulement si vous choisissez volontairement de repartir à zéro.
SUPABASE_ALLOW_EMPTY_INIT=0

# Ancien stockage Blob — utile uniquement pour une migration ponctuelle si l'accès est restauré.
BLOB_STATE_PATH=calasorga/store.json
