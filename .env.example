# Exemple pour un serveur Node / Docker local uniquement.
# Sur Vercel, créez les variables dans l’interface et laissez Vercel gérer ses variables Blob.
ADMIN_TOKEN=change-me-with-a-long-random-secret
ADMIN_CODE=ABC123
MEMBER_SHORT_SECRET=change-me-with-an-independent-random-secret-at-least-32-characters
DATA_FILE=./data/store.json
PORT=3000
TRUST_PROXY=0
BLOB_STATE_PATH=calasorga/store.json
